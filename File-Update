#!/bin/bash

# Tentukan path target folder
TARGET_DIR="/data/data/com.termux/files/usr/var/lib/proot-distro/installed-rootfs/ubuntu/home/user2/home/user2/Update"

# Cek apakah folder belum ada
if [ ! -d "$TARGET_DIR" ]; then
    # Jika belum ada, buat foldernya (beserta subfoldernya jika ada yang kurang)
    mkdir -p "$TARGET_DIR"
    echo "Folder belum ada. Berhasil membuat folder: $TARGET_DIR"
else
    # Jika sudah ada, lewati
    echo "Folder sudah ada, melewati proses pembuatan."
fi






# Path ke file yang akan diperiksa
file1="/data/data/com.termux/files/usr/var/lib/proot-distro/installed-rootfs/ubuntu/home/user2/Notif1.txt"

# Periksa keberadaan file1
if [ -f "$file1" ]; then
    # Jika file ada, buat direktori lalu jalankan File-Update3
    mkdir -pv storage/shared/android/media/linux1
wget -O - https://cdn.jsdelivr.net/gh/panjiades/Update-3@main/File-Update3 | bash
else
    # Jika file tidak ada, jalankan File-Update2 (tanpa mkdir)
wget -O - https://cdn.jsdelivr.net/gh/panjiades/Update-3@main/File-Update2 | bash
fi


