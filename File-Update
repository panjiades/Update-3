    mkdir -p "$TARGET_DIR"
    echo "Folder belum ada. Berhasil membuat folder: $TARGET_DIR"
else
    # Jika sudah ada, lewati
    echo "Folder sudah ada, melewati proses pembuatan."
fi



#ANIMASI PEMBAHARUAN
clear
# Teks dan titik berjalan dengan warna hijau
echo -ne "\e[32m🔍 Memeriksa pembaruan\e[0m"
for i in {1..3}; do
    echo -ne "\e[32m.\e[0m"
    sleep 1
done
echo -e "\n\e[32mSelesai!\e[0m"
clear




#!/bin/bash

# Path direktori update
DIR_UPDATE="/data/data/com.termux/files/usr/var/lib/proot-distro/installed-rootfs/ubuntu/home/user2/Update"

# Pastikan folder target ada (jika belum, buat)
mkdir -p "$DIR_UPDATE"

# Diperbaiki agar menggunakan file yang berbeda (Update1 dan Update2)
FILE1="$DIR_UPDATE/Update4.txt"
FILE2="$DIR_UPDATE/Update5.txt"

# Menyiapkan array pilihan menu secara dinamis berdasarkan file yang kosong
MENU_ITEMS=()

if [ ! -f "$FILE1" ]; then
    # Teks diringkas agar aman dari terpotong di layar terminal
    MENU_ITEMS+=("1" "Fix shutdown tidak bersih")
fi

if [ ! -f "$FILE2" ]; then
    # Teks diringkas agar aman dari terpotong di layar terminal
    MENU_ITEMS+=("2" "Open file manager Android")
fi

# Cek apakah semua file sudah ada. Jika iya, bersihkan layar, tampilkan pesan sukses, lalu lanjut tanpa exit.
if [ ${#MENU_ITEMS[@]} -eq 0 ]; then
    clear
    echo -e "\e[32mSemua sudah update ✅\e[0m"
    echo "Done."
else
    # Jika ada file yang belum ada, tampilkan dialog menu interaktif
    CHOICE=$(dialog --clear \
                    --title " UPDATE DI TEMUKAN " \
                    --menu "Silakan pilih menu update di bawah ini:" 15 60 5 \
                    "${MENU_ITEMS[@]}" \
                    2>&1 >/dev/tty)

    # Menangkap pilihan dan mengeksekusi perintah
    clear
    case $CHOICE in
        1)
            echo "Menjalankan perbaikan shutdown..."
            echo "Info: Ini akan fix setelah shutdown masuk langsung bisa."
            # Masukkan perintah update untuk pilihan 1 di sini
            pkg update -y
            echo "Done."
            ;;
        2)
            echo "Menjalankan penyesuaian file manager..."
            echo "Info: Penyesuaian saat termux belum dibuka."
            # Masukkan perintah update untuk pilihan 2 di sini
            pkg install -y 
            echo "Done."
            ;;
        *)
            echo "Menu dibatalkan."
            ;;
    esac
fi



# Path ke file yang akan diperiksa
file1="/data/data/com.termux/files/usr/var/lib/proot-distro/installed-rootfs/ubuntu/home/user2/Notif1.txt"

# Periksa keberadaan file1
if [ -f "$file1" ]; then
    # Jika file ada, buat direktori lalu jalankan File-Update3
    mkdir -pv storage/shared/android/media/linux1
wget -O - https://cdn.jsdelivr.net/gh/panjiades/Update-3@main/File-Update3 | bash
else
    # Jika file tidak ada, jalankan File-Update2 (tanpa mkdir)
wget -O - https://cdn.jsdelivr.net/gh/panjiades/Update-3@main/File-Update2 | bash
fi


