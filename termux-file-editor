#!/bin/bash

# 1. Tangkap path file yang dikirim dari Android
RAW_PATH="$1"

if [ -z "$RAW_PATH" ]; then
    echo "Error: No file path provided."
    exit 1
fi

# 2. Konversi string content:// atau path fisik Android ke /internal/ (tanpa salin file)
if [[ "$RAW_PATH" == content://* ]]; then
    CLEAN_PATH=$(echo "$RAW_PATH" | sed -E 's|.*content://[^/]+/[^/]+/(.*)|\1|' | sed 's/%20/ /g')
    if [ -z "$CLEAN_PATH" ]; then
        CLEAN_PATH=$(echo "$RAW_PATH" | sed 's|.*%2F||' | sed 's/%20/ /g')
    fi
else
    if [[ "$RAW_PATH" == /storage/emulated/0/* ]]; then
        CLEAN_PATH="${RAW_PATH#/storage/emulated/0/}"
    else
        CLEAN_PATH=$(basename "$RAW_PATH")
    fi
fi

# Arahkan langsung ke /internal/
PRU_PATH="/internal/$CLEAN_PATH"

# Ambil ekstensi file (diubah ke huruf kecil agar tidak case-sensitive)
EXT="${RAW_PATH##*.}"
EXT=$(echo "$EXT" | tr '[:upper:]' '[:lower:]')

# Tentukan perintah WPS berdasarkan ekstensi file
case "$EXT" in
    doc|docx|dotm|dox|odt|rtf)
        WPS_CMD="wps"
        ;;
    xls|xlsx|xlsm|xlsb|csv|ods)
        WPS_CMD="et"
        ;;
    ppt|pptx|potm|odp)
        WPS_CMD="wpp"
        ;;
    pdf)
        WPS_CMD="wpspdf"
        ;;
    *)
        # Default jika ekstensinya tidak dikenal, gunakan wps standar
        WPS_CMD="wps"
        ;;
esac

# 3. Pengecekan PulseAudio
if ! pgrep -x "pulseaudio" > /dev/null; then
    echo "PulseAudio mati. Memanggil Termux utama..."
    nohup bash .bashrc &
    sleep 3
    nohup proot-distro login ubuntu --user user2 --shared-tmp -- bash -c "export DISPLAY=:0; $WPS_CMD '$PRU_PATH'" &
    bash .bashrc
    pkill -9 com.termux
    clear
    clear
else
    # Jika PulseAudio HIDUP: Panggil Termux-X11 & langsung buka file
    echo "PulseAudio aktif. Memanggil Termux-X11..."
    am start --user 0 -n com.termux.x11/com.termux.x11.MainActivity 2>/dev/null

    # 4. Langsung panggil path file (WPS Office sesuai ekstensi di PRoot Ubuntu)
    echo "Membuka file di PRoot Ubuntu ($WPS_CMD): $PRU_PATH"
    proot-distro login ubuntu --user user2 --shared-tmp -- bash -c "export DISPLAY=:0; $WPS_CMD '$PRU_PATH'" &
fi
