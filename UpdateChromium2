#!/bin/bash
proot-distro login ubuntu --user user2 --shared-tmp -- bash -c '
cd
sudo apt install -y google-chrome-stable

mkdir -p "$HOME/Desktop" "$HOME/.local/share/applications"

cat << "EOF" > "$HOME/Desktop/google-chrome.desktop"
[Desktop Entry]
Version=1.0
Type=Application
Name=Google Chrome
Comment=Access the Internet
Exec=/usr/bin/google-chrome-stable --no-sandbox --password-store=basic %U
Icon=google-chrome
Terminal=false
Categories=Network;WebBrowser;
StartupNotify=true
EOF

chmod +x "$HOME/Desktop/google-chrome.desktop"
cp "$HOME/Desktop/google-chrome.desktop" "$HOME/.local/share/applications/google-chrome.desktop"
echo "Desktop entry berhasil dibuat di $HOME/Desktop/google-chrome.desktop"
'