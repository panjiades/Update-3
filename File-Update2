#!/bin/bash

# Pastikan package dialog sudah terinstall: pkg install dialog
BACKTITLE="Informasi Sistem Termux"
TITLE="PERINGATAN"
MENU="Versi Termux ini sudah tidak didukung / kedaluararsa.\n\nUpdate Termux V4 terbaru akan mendapatkan dukungan lebih lama:\n- Fitur print\n- Fix audio tidak keluar\n- Open file dokumen langsung dari file manager android\n- Scroll dan klik kanan 1 jari\n- Dan masih banyak lagi"

# Daftar pilihan menu (Tag dan Deskripsi)
OPTIONS=(
    "A" "Lihat Tutorial update"
    "B" "Cancel exit"
)

# Memanggil kotak dialog berbasis teks (default layar biru dialog ncurses)
CHOICE=$(dialog --backtitle "$BACKTITLE" \
                --title "$TITLE" \
                --menu "$MENU" 18 65 2 \
                "${OPTIONS[@]}" 2>&1 >/dev/tty)

clear

# Menangani hasil pilihan pengguna
case $CHOICE in
    A)
        echo -e "\n\033[36mMembuka Tutorial update di YouTube...\033[0m"
        am start -a android.intent.action.VIEW -d "https://youtube.com/watch?v=f6sP-8sJZZ4&si=ePGLKnU6PlLJ9l6Z"
        exit 0
        ;;
    B)
        echo -e "\n\033[31mKeluar dari program.\033[0m"
        exit 0
        ;;
    *)
        echo -e "\nKeluar / Dibatalkan."
        exit 0
        ;;
esac
