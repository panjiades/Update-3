#!/bin/bash
proot-distro login ubuntu --user user2 --shared-tmp -- bash -c '
cd
sudo apt install -y brave-browser

mkdir -p "$HOME/Desktop" "$HOME/.local/share/applications"

cat << "EOF" > "$HOME/Desktop/brave-browser.desktop"
[Desktop Entry]
Version=1.0
Type=Application
Name=Brave Browser
Comment=Access the Internet
Exec=/usr/bin/brave-browser --no-sandbox --password-store=basic %U
Icon=brave-browser
Terminal=false
Categories=Network;WebBrowser;
StartupNotify=true
EOF

chmod +x "$HOME/Desktop/brave-browser.desktop"
cp "$HOME/Desktop/brave-browser.desktop" "$HOME/.local/share/applications/brave-browser.desktop"
echo "Desktop entry berhasil dibuat di $HOME/Desktop/brave-browser.desktop"
'